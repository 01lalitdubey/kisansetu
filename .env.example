# KisanSetu AI — Frontend configuration
# All values are OPTIONAL. With none set, the app runs fully on mock data.

# ---------------------------------------------------------------------------
# Backend REST API (see /backend).
# ---------------------------------------------------------------------------
VITE_API_BASE_URL=http://localhost:5000/api

# Master switch. "true"  -> use the backend, fall back to mocks if it is down.
#               "false"/unset -> always use mock services (offline demo).
VITE_USE_BACKEND=false

# ---------------------------------------------------------------------------
# Phase 4 — Supabase Auth (farmer sign-in). OPTIONAL.
# Without these, the auth screen offers "Continue as demo farmer".
# Supabase dashboard -> Project Settings -> API
# ---------------------------------------------------------------------------
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# ---------------------------------------------------------------------------
# Phase 4 — Stripe publishable key (safe to expose). OPTIONAL.
# The SECRET key lives only in the backend. Without a key the payment screen
# shows an explicit "Demo Payment" (no real money).
# ---------------------------------------------------------------------------
VITE_STRIPE_PUBLISHABLE_KEY=

# ---------------------------------------------------------------------------
# Maps: the in-app map now uses Leaflet + OpenStreetMap (NO key required).
# Address search uses OpenStreetMap Nominatim (no key). This var is unused by
# the embedded map; "View on Google Maps" / "Directions" are plain external
# links built from verified coordinates.
# ---------------------------------------------------------------------------
VITE_GOOGLE_MAPS_API_KEY=

# WebSocket endpoint for the live queue (future — frontend currently polls)
VITE_QUEUE_WS_URL=ws://localhost:5000/ws/queue

# Keep the demo controls visible in the officer dashboard
VITE_ENABLE_DEMO_MODE=true
