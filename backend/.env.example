# ---------------------------------------------------------------------------
# KisanSetu AI — Backend environment
# Copy to `.env` and fill in. Never commit `.env`.
# ---------------------------------------------------------------------------

# Server
PORT=5000
NODE_ENV=development

# Frontend origin allowed by CORS (the Vite dev server)
FRONTEND_URL=http://localhost:5173

# JWT
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# ---------------------------------------------------------------------------
# Database (PostgreSQL)
# ---------------------------------------------------------------------------
# Supabase (recommended): Project Settings -> Database -> Connection string
#   DATABASE_URL  -> the "Transaction" pooler URL (port 6543, ?pgbouncer=true)
#   DIRECT_URL    -> the "Session" / direct URL (port 5432)  [used by prisma migrate]
#
# DATABASE_URL="postgresql://postgres.xxxx:[PASSWORD]@aws-0-xx.pooler.supabase.com:6543/postgres?pgbouncer=true"
# DIRECT_URL="postgresql://postgres.xxxx:[PASSWORD]@aws-0-xx.pooler.supabase.com:5432/postgres"

# Local development (Docker Postgres — see backend/README.md):
DATABASE_URL="postgresql://kisansetu:kisansetu@localhost:55432/kisansetu?schema=public"
DIRECT_URL="postgresql://kisansetu:kisansetu@localhost:55432/kisansetu?schema=public"

# Demo login accounts created by the seed (password for all three below)
DEMO_PASSWORD=demo1234

# ---------------------------------------------------------------------------
# Phase 4 — Supabase Auth (farmer identity provider). ALL OPTIONAL.
# Leave blank and the backend keeps accepting the demo JWT login.
# Supabase dashboard -> Project Settings -> API / Auth
# ---------------------------------------------------------------------------
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Settings -> API -> JWT Settings -> "JWT Secret" (enables fast local verification)
SUPABASE_JWT_SECRET=
# Optional: only needed if you want the backend to call the Supabase Admin API
SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------------------
# Phase 4 — Stripe (transport payments). ALL OPTIONAL.
# When STRIPE_SECRET_KEY is blank the app shows an explicit "Demo Payment"
# button that charges no real money.
# ---------------------------------------------------------------------------
STRIPE_SECRET_KEY=
# Stripe CLI: `stripe listen --forward-to localhost:5000/api/payments/stripe/webhook`
STRIPE_WEBHOOK_SECRET=
# Where Stripe redirects after checkout (defaults derived from FRONTEND_URL)
STRIPE_SUCCESS_URL=
STRIPE_CANCEL_URL=

# KisanSetu AI platform service fee charged on top of transport cost (0.01 = 1%)
PLATFORM_FEE_RATE=0.01

# ---------------------------------------------------------------------------
# Gemini AI assistant (farmer chatbot). OPTIONAL.
# Get a key from https://aistudio.google.com/apikey — NEVER commit it, and
# NEVER put it in frontend code/env. When blank, the assistant automatically
# falls back to KisanSetu's built-in rule-based assistant (still uses real
# farmer/queue/token data — it just doesn't call Gemini).
# ---------------------------------------------------------------------------
GEMINI_API_KEY=
# Any current Gemini model your API key has access to. Defaults to
# gemini-2.5-flash if left blank.
GEMINI_MODEL=gemini-2.5-flash
